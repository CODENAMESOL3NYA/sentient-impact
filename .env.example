# =============================================================================
# Sentient Analyst — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# watsonx.ai Credentials (required when USE_LIVE_LLM=true)
# -----------------------------------------------------------------------------

# IBM Cloud IAM API key — https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=

# watsonx.ai project ID — found in your project settings
WATSONX_PROJECT_ID=

# watsonx.ai service URL (default: https://us-south.ml.cloud.ibm.com)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Foundation model ID to use for both agents
# (default: ibm/granite-3-3-8b-instruct)
WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------

# Set to "true" to call live watsonx.ai models instead of mock adapters.
# When false (default), the server runs entirely offline using seeded mock data.
USE_LIVE_LLM=false

# -----------------------------------------------------------------------------
# GitHub Integration (required for /api/github/prs and /api/analyze-github-pr)
# -----------------------------------------------------------------------------

# GitHub Personal Access Token — https://github.com/settings/tokens
# Required for private repos; optional for public repos (unauthenticated = 60 req/hr).
GITHUB_TOKEN=

# Maximum number of characters from the assembled PR diff forwarded to the
# analysis pipeline. Protects the model context window for large monorepo PRs.
# (default: 40000)
DIFF_MAX_CHARS=40000

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Port the Express server listens on (default: 3001)
PORT=3001

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------

# Duration of the rate-limit sliding window in milliseconds (default: 60000 = 1 min)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per IP per window for the analysis endpoints (default: 30)
RATE_LIMIT_MAX_REQUESTS=30

# -----------------------------------------------------------------------------
# Development / Testing
# -----------------------------------------------------------------------------

# Artificial delay (ms) added by mock adapters to simulate agent execution time.
# Set to 0 for instant responses during unit tests. (default: 0)
AGENT_SIMULATION_DELAY_MS=0
